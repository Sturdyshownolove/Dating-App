# Expo public env vars (inlined into the JS bundle at build time).
# Anything prefixed `EXPO_PUBLIC_` is readable by any client; only put
# values that are already PUBLIC by design (SDK keys, public IDs) here.
# Secret keys (RC v2 API key, Cloudinary api_secret) belong in
# `firebase functions:config:set`, NOT here.

# RevenueCat — SDK keys, platform-specific. Get them from
# RevenueCat dashboard → Project Settings → API Keys.
# iOS keys start with `appl_`, Android keys with `goog_`.
# Test keys (`test_*`) work for both platforms in development only.
EXPO_PUBLIC_RC_KEY_IOS=appl_xxx_replace_me
EXPO_PUBLIC_RC_KEY_ANDROID=goog_xxx_replace_me

# Production builds must set these via EAS instead of a local .env:
#   eas secret:create --name EXPO_PUBLIC_RC_KEY_IOS     --value appl_...
#   eas secret:create --name EXPO_PUBLIC_RC_KEY_ANDROID --value goog_...

# Sentry DSN — telemetry + error tracking. Empty value (or absent) disables
# Sentry entirely (init is gated on this being non-empty). Get the DSN
# from Sentry project Settings → Client Keys (DSN).
# beforeSend hook in app/_layout.tsx scrubs PII (emails, phones) from
# messages and breadcrumbs before send.
EXPO_PUBLIC_SENTRY_DSN=

# Production builds: eas secret:create --name EXPO_PUBLIC_SENTRY_DSN --value https://...@o0.ingest.sentry.io/0
